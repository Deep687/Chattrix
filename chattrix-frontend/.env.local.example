BACKEND_URL=https://chattrix-backend.test
NEXT_PUBLIC_BACKEND_URL=https://chattrix-backend.test

# Node's fetch doesn't trust Herd's local CA — disable TLS check in dev only
NODE_TLS_REJECT_UNAUTHORIZED=0

# Public URL of this frontend; used for link-preview (Open Graph) image URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
